---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';
---
<Base title="Repair Services" description="All repair services at Tek Media Group in Burbank: lenses, camcorders, Bang & Olufsen, projectors, monitors, hi-fi and reel-to-reel.">
  <section class="page-hero"><div class="wrap"><h1>Repair services</h1><p>Pro video, broadcast and audio equipment, repaired in Burbank.</p></div></section>
  <section class="section"><div class="wrap grid grid-3">
    {services.map((s) => (
      <a class="card" href={`/services/${s.slug}/`}>
        <h3>{s.short}</h3>
        <ul class="tags">{s.brands.map((b) => <li>{b}</li>)}</ul>
        <p>{s.summary}</p><span class="more">Learn more →</span>
      </a>
    ))}
  </div></section>
</Base>
