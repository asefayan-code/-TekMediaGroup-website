---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services, hubs } from '../../data/services';
---
<Base title="Repair Services" description="All repair services at Tek Media Group in Burbank: lenses, cameras, decks, RED, projectors, monitors, Epson printers, Bang & Olufsen, hi-fi and reel-to-reel.">
  <section class="page-hero"><div class="wrap"><h1>Repair services</h1><p>Pro video, broadcast, printing and audio equipment, repaired in Burbank.</p></div></section>
  <section class="section"><div class="wrap grid grid-3">
    {services.map((s) => <ServiceCard href={`/services/${s.slug}/`} title={s.short} summary={s.summary} img={s.images?.[0]} />)}
    {hubs.map((h) => <ServiceCard href={h.href} title={h.short} summary={h.summary} tile={h.tile} />)}
    <ServiceCard href="/capacitor-replacement/" title="Capacitor Replacement" summary="Why we replace the capacitors that need it, not every one on the board." tile="Capacitors" cta="Read more →" />
  </div></section>
</Base>
