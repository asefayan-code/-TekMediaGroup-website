---
import Base from '../../layouts/Base.astro';
import ContentView from '../../components/ContentView.astro';
import { site } from '../../data/site';
import { services, hubs } from '../../data/services';
import type { ContentPage } from '../../data/types';

export function getStaticPaths() {
  return services.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: ContentPage };
const related = [
  ...services.filter((s) => s.slug !== page.slug).map((s) => ({ href: `/services/${s.slug}/`, label: s.short })),
  ...hubs.map((h) => ({ href: h.href, label: h.short })),
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'Service', name: page.title, description: page.summary,
  provider: { '@id': `${site.url}/#business` }, areaServed: 'United States',
}];
---
<Base title={`${page.title} in Burbank, CA`} description={page.summary} schema={schema}>
  <ContentView page={page} crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: page.short }]} related={related} relatedTitle="Other services" />
</Base>
