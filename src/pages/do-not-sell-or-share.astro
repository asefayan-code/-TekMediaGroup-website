---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Do Not Sell or Share My Personal Information')}&body=${encodeURIComponent('Please opt me out of the sale or sharing of my personal information.\n\nName:\nEmail:\nPhone:\n')}`;
---
<Base title="Do Not Sell or Share My Personal Information" description="Opt out of the sale or sharing of your personal information for advertising.">
  <section class="page-hero"><div class="wrap"><h1>Do Not Sell or Share My Personal Information</h1><p>Opt out of advertising use of your personal information.</p></div></section>
  <section class="section"><div class="wrap prose">
    <p>
      We may share identifiers such as your email address and phone number, and website activity, with advertising and
      marketing partners to show you ads and measure results. Under California law this may be "selling" or "sharing."
      You can tell us to stop at any time. You do not need an account, and we will not ask for more information than we
      need to process your request.
    </p>
    <h2>Ways to opt out</h2>
    <ul class="check-list">
      <li><a href={mail}>Email us your opt-out request</a> at {site.email} with your name, email address and phone number.</li>
      <li>Call us at <a href={site.tollFreeHref}>{site.tollFree}</a> or <a href={site.phoneHref}>{site.phone}</a>.</li>
      <li>Turn on <strong>Global Privacy Control</strong> in your browser. We treat it as an opt-out for that browser.</li>
    </ul>
    <p id="gpc-status" class="muted"></p>
    <p>
      Once we receive your request, we will stop sharing your information with advertising and marketing partners and
      remove it from future advertising lists, within 15 business days. You may also use an authorized agent to submit
      a request. See our <a href="/privacy/">Privacy Policy</a> for details.
    </p>
  </div></section>
  <script is:inline>
    if (navigator.globalPrivacyControl) {
      var el = document.getElementById('gpc-status');
      if (el) el.textContent = 'Your browser is sending a Global Privacy Control signal. We honor it as an opt-out for this browser, and advertising tags on this site will not load.';
    }
  </script>
</Base>
