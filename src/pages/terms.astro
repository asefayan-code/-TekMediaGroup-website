---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
// DRAFT — review before launch, or replace with the text from the old Terms.aspx page.
---
<Base title="Terms of Service">
  <section class="page-hero"><div class="wrap"><h1>Terms of service</h1></div></section>
  <section class="section"><div class="wrap prose">
    <h2>Estimates</h2>
    <p>Estimates are free. We do not charge a diagnosis fee on out-of-warranty products. No repair work begins until you approve the estimate.</p>
    <h2>Shipping</h2>
    <p>Customers are responsible for insuring equipment shipped to us. Please remove accessories and media before shipping.</p>
    <h2>Payment</h2>
    <p>We accept {site.paymentMethods.join(', ')}. Payment is due before equipment is returned.</p>
    <h2>Contact</h2>
    <p>Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
  </div></section>
</Base>
