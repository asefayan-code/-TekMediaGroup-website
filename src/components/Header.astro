---
import { site } from '../data/site';
import { services, hubs } from '../data/services';
const path = Astro.url.pathname;
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <span>{site.hours[0].days}, {site.hours[0].time}</span>
    <span class="topbar-links">
      <a href={site.portal.ticketLookup}>Check ticket status</a>
      <a href={site.portal.login}>Customer login</a>
    </span>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img src="/images/logo-240.webp" srcset="/images/logo-240.webp 1x, /images/logo-480.webp 2x" width="160" height="55" alt="Tek Media Group" class="brand-logo" />
      <span class="brand-text"><small>Electronics Service &amp; Repair<br />Since 1991</small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav" aria-label="Main">
      <details class="nav-drop">
        <summary class:list={[{ active: ['/services','/bang-olufsen','/brands','/hifi','/reel'].some((p) => path.startsWith(p)) }]}>Services</summary>
        <ul>
          <li class="drop-head">Video &amp; broadcast</li>
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.short}</a></li>)}
          <li class="drop-head">Audio</li>
          {hubs.map((h) => <li><a href={h.href}>{h.short}</a></li>)}
          <li class="drop-head">More</li>
          <li><a href="/services/">All services</a></li>
          <li><a href="/capacitor-replacement/">Capacitor replacement</a></li>
        </ul>
      </details>
      <a href="/how-to-get-service/" class:list={[{ active: path.startsWith('/how-to') }]}>How it works</a>
      <a href="/about/" class:list={[{ active: path.startsWith('/about') }]}>About</a>
      <a href="/contact/" class:list={[{ active: path.startsWith('/contact') }]}>Contact</a>
      <a href={site.phoneHref} class="nav-phone">{site.phone}</a>
      <a href={site.portal.newTicket} class="btn btn-primary btn-sm">Start a repair</a>
    </nav>
  </div>
</header>
